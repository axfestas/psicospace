generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ESTUDANTE
  DOCENTE
  ADMIN
  SUPERADMIN
}

enum MaterialType {
  PDF
  SLIDE
  LINK
}

enum ProgressStatus {
  NOT_VIEWED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  password                String
  role                    Role      @default(ESTUDANTE)
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  avatarUrl               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  events              Event[]
  tasks               Task[]
  notes               Note[]
  documents           Document[]
  notifications       Notification[]
  materialProgress    MaterialProgress[]
  uploadedMaterials   Material[]
  libraryItems        LibraryItem[]
  microTasks          MicroTask[]
  studySessions       StudySession[]
  psicoWallet         PsicoWallet?
  characterProgress   CharacterProgress?
  exerciseAttempts    ExerciseAttempt[]
  exerciseReviews     ExerciseReview[]
  createdExercises    Exercise[]         @relation("CreatedExercises")
  approvedExercises   Exercise[]         @relation("ApprovedExercises")
}

model Period {
  id          String       @id @default(cuid())
  name        String
  order       Int
  createdAt   DateTime     @default(now())
  disciplines Discipline[]
}

model Discipline {
  id          String     @id @default(cuid())
  name        String
  periodId    String
  description String?
  createdAt   DateTime   @default(now())
  period      Period     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  materials   Material[]
}

model Material {
  id           String           @id @default(cuid())
  title        String
  type         MaterialType
  url          String
  disciplineId String
  uploadedById String
  libraryItemId String?
  createdAt    DateTime         @default(now())
  discipline   Discipline       @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  libraryItem  LibraryItem?     @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)
  progress     MaterialProgress[]
  microTasks   MicroTask[]
  exercises    Exercise[]
}

model LibraryItem {
  id           String       @id @default(cuid())
  title        String
  description  String?
  type         MaterialType
  url          String
  thumbnailUrl String?
  uploadedById String
  createdAt    DateTime     @default(now())
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  materials    Material[]
  exercises    Exercise[]
}

model MaterialProgress {
  id          String         @id @default(cuid())
  userId      String
  materialId  String
  status      ProgressStatus @default(NOT_VIEWED)
  currentPage Int            @default(0)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id        String    @id @default(cuid())
  title     String
  completed Boolean   @default(false)
  userId    String
  createdAt DateTime  @default(now())
  dueDate   DateTime?
  group     String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Study system ────────────────────────────────────────────────────────────

model MicroTask {
  id          String         @id @default(cuid())
  title       String
  description String?
  materialId  String?
  userId      String
  order       Int            @default(0)
  completed   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  material    Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    StudySession[]
}

// phase: selecting | pomodoro | content | recall | break | done
// status: active | completed | abandoned
model StudySession {
  id                 String               @id @default(cuid())
  userId             String
  microTaskId        String
  materialId         String?
  status             String               @default("active")
  phase              String               @default("selecting")
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  totalSeconds       Int                  @default(0)
  pomodorosCompleted Int                  @default(0)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  microTask          MicroTask            @relation(fields: [microTaskId], references: [id], onDelete: Cascade)
  recallAnswers      ActiveRecallAnswer[]
}

model ActiveRecallAnswer {
  id        String       @id @default(cuid())
  sessionId String
  question  String
  answer    String
  createdAt DateTime     @default(now())
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ── Exercises ───────────────────────────────────────────────────────────────

// type: MULTIPLE_CHOICE | OPEN | COMPREHENSION | APPLICATION
// status: PENDING | APPROVED | REJECTED
// sourceType: MANUAL | AI
model Exercise {
  id            String           @id @default(cuid())
  title         String
  type          String
  question      String
  answer        String?
  explanation   String?
  difficulty    String           @default("MEDIO")
  materialId    String?
  libraryItemId String?
  createdById   String
  status        String           @default("PENDING")
  approvedById  String?
  approvedAt    DateTime?
  sourceType    String           @default("MANUAL")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  options       ExerciseOption[]
  material      Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  libraryItem   LibraryItem?     @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)
  attempts      ExerciseAttempt[]
  reviews       ExerciseReview[]
  createdBy     User             @relation("CreatedExercises", fields: [createdById], references: [id])
  approvedBy    User?            @relation("ApprovedExercises", fields: [approvedById], references: [id])
}

model ExerciseOption {
  id         String   @id @default(cuid())
  exerciseId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model ExerciseAttempt {
  id           String   @id @default(cuid())
  userId       String
  exerciseId   String
  answer       String?
  selectedOptionId String?
  isCorrect    Boolean  @default(false)
  rewardedAt   DateTime?
  rewardAmount Int      @default(0)
  attemptedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
}

model ExerciseReview {
  id             String   @id @default(cuid())
  userId         String
  exerciseId     String
  interval       Int      @default(1)
  repetitions    Int      @default(0)
  easeFactor     Float    @default(2.5)
  nextReviewAt   DateTime @default(now())
  lastReviewedAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
}

// ── Gamification (PsicoGame) ────────────────────────────────────────────────

model PsicoWallet {
  id           String             @id @default(cuid())
  userId       String             @unique
  balance      Int                @default(0)
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PsicoTransaction[]
}

// type: EARN | SPEND
// reason: session_completed | recall_answered | microtask_done | item_purchased
model PsicoTransaction {
  id          String      @id @default(cuid())
  walletId    String
  amount      Int
  type        String
  reason      String
  referenceId String?
  createdAt   DateTime    @default(now())
  wallet      PsicoWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model CharacterProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  level         Int      @default(1)
  xp            Int      @default(0)
  totalSessions Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastSessionAt DateTime?
  ownedItems    String   @default("[]")
  equippedItems String   @default("{}")
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// type: AVATAR_FRAME | BACKGROUND | BADGE | TITLE
// category: AVATAR | TEMA | CONQUISTA | ESPECIAL
// rarity: COMUM | INCOMUM | RARO | ÉPICO | LENDÁRIO
model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String
  slot        String
  category    String   @default("GERAL")
  rarity      String   @default("COMUM")
  price       Int
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  content   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(cuid())
  title     String
  content   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
